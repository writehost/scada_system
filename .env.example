# PostgreSQL для `/api/wms/*`, если API обслуживается этим же Next-процессом (junction).
# Иначе используется WMS_BACKEND_URL или web/wms-config.json
# DATABASE_URL=postgres://user:password@localhost:5432/scadatable?sslmode=disable
# PG_URL=postgres://user:password@localhost:5432/scadatable?sslmode=disable

# Backend WMS (`web/` на порту 3001). Для Vercel preview — URL staging/production backend.
# Vercel Preview (frontend-only, API через rewrite в next.config.mjs):
#   WMS_BACKEND_URL=https://scada25.ru
# Не задавайте NEXT_PUBLIC_WMS_API_ORIGIN — браузер ходит на /api/wms/* того же origin (rewrite).
# Для работы Bearer после login на preview задайте тот же секрет, что на scada25.ru:
#   WMS_AUTH_SECRET=<production-secret>
WMS_BACKEND_URL=http://YOUR_SERVER_IP:3001

# Отключить dev-прокси если API на другом хосте
# WMS_DISABLE_DEV_PROXY=1

# gRPC codesvc (если используются scan/registry routes в этом процессе)
# CODESVC_GRPC_ADDR=127.0.0.1:8081

# Bearer для /api/wms/crpt/info на ТСД (или crptBearerToken в web/wms-config.json)
# WMS_CRPT_BEARER_TOKEN=your-secret-token

# Сервер обновлений (scada25.ru)
WMS_UPDATE_SERVER_URL=https://scada25.ru
WMS_UPDATE_SERVER_TOKEN=shared-secret-with-scada25
NEXT_PUBLIC_WMS_UPDATE_POLL_MS=120000

# QPass (https://qpass.scada25.ru) — токен организации, ключ паспорта: точное name + serialNumber
# QPASS_ORIGIN=https://qpass.scada25.ru
# QPASS_API_TOKEN=iqd_…
