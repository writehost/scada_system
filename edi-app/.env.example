# Общая база SCADA System (та же wms_edge, что у WMS и YMS)
DATABASE_URL=postgres://user:password@127.0.0.1:5432/wms_edge?sslmode=disable

# Обязательные секреты в production (не коммитить)
EDI_AUTH_SECRET=change-me-long-random
EDI_SECRET_KEY=change-me-another-long-random   # шифрование токенов интеграций в БД

EDI_PUBLIC_ORIGIN=https://edi.example.ru
# EDI_AUTH_COOKIE_SECURE=true

# Вход через SCADA ID (клиент scada-edi в реалме; без секрета кнопка не показывается)
# SCADA_ID_ISSUER=https://id.scada25.ru/realms/scada-system-id
# SCADA_ID_API=https://id.scada25.ru
# SCADA_ID_EDI_CLIENT_ID=scada-edi
# SCADA_ID_EDI_CLIENT_SECRET=

# Файлы: local (каталог) или s3 (S3-совместимое хранилище)
EDI_STORAGE=local
EDI_STORAGE_DIR=/var/lib/scada-edi/storage
# EDI_STORAGE=s3
# EDI_S3_ENDPOINT=https://storage.yandexcloud.net
# EDI_S3_REGION=ru-central1
# EDI_S3_BUCKET=scada-edi
# EDI_S3_ACCESS_KEY_ID=
# EDI_S3_SECRET_ACCESS_KEY=
EDI_MAX_FILE_MB=25

# WMS можно подключить в интерфейсе (Администрирование → Интеграции) или здесь
# WMS_API_URL=https://wms.scada25.ru
# WMS_API_TOKEN=wmsu_…   # персональный токен сервисного пользователя WMS
# WMS_SITE_CODE=skeet

# Тариф по умолчанию для новой организации (trial | business | professional | enterprise)
EDI_DEFAULT_PLAN=trial
# Логины операторов платформы (тарифы, реестр форматов)
# EDI_PLATFORM_ADMINS=admin@scada25.ru

# Email-уведомления
# EDI_SMTP_URL=smtps://user:pass@smtp.example.ru:465
# EDI_MAIL_FROM=edi@example.ru

# Фоновый исполнитель в процессе Next (EDI_WORKER=0 — выключить)
# EDI_WORKER_INTERVAL_MS=60000
