    "test:route:ui": "node tests/route/preview/build.mjs /tmp/route-preview && node tests/route/ui.e2e.mjs /tmp/route-shots",
    "route:draft-map": "python3 scripts/route-draft-map.py"
  },
  "dependencies": {
    "next": "16.2.4",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "5.7.3",
    "@tailwindcss/postcss": "^4.2.0",
    "tailwindcss": "^4.2.0"
  }
