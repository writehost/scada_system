    "start": "next start -H 127.0.0.1 -p 3014",
    "test": "node --experimental-strip-types --test scripts/test-ops.mjs",
    "test:route:unit": "tsx --tsconfig tests/route/tsconfig.yms.json --test tests/route/unit.test.ts",
