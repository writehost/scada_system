# PostgreSQL. Роль приложения — НЕ суперпользователь и без BYPASSRLS (иначе RLS не действует).
EMS_DATABASE_URL=postgres://ems_app:CHANGE_ME@127.0.0.1:5432/scadatable?sslmode=disable
EMS_DB_POOL_MAX=10

# Подпись сессий и секретов устройств (не короче 32 символов)
EMS_AUTH_SECRET=
EMS_PUBLIC_URL=https://ems.example.ru
# EMS_COOKIE_SECURE=true

# SCADA ID (тот же realm, что у WMS)
SCADA_ID_ISSUER=https://id.scada25.ru/realms/scada-system-id
SCADA_ID_API=https://id.scada25.ru
SCADA_ID_CLIENT_ID=ems
SCADA_ID_CLIENT_SECRET=
SCADA_ID_APPLICATION=scada-ems
# 0 — без личных пространств (только организации из SCADA ID)
# EMS_PERSONAL_ACCOUNTS=1

# Почта: helper — существующий помощник WMS; file — запись писем в каталог (отладка); none — не отправлять
EMS_MAIL_PROVIDER=helper
# WMS_SEND_MAIL_BIN=/usr/local/bin/wms-send-mail.py
# EMS_MAIL_DIR=./var/mail

# Лимит запросов на пользователя/токен в минуту (на экземпляр)
# EMS_RATE_LIMIT_PER_MIN=600

# Только для разработки: вход без SCADA ID (не работает в production-сборке)
# EMS_DEV_LOGIN=1
