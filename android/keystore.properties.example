# Подпись OTA для ТСД (полевые устройства ставились через USB / Android Studio).
# Используйте ~/.android/debug.keystore — иначе обновление поверх установленного не пройдёт.
#
# Windows (пример):
# storeFile=C\:\\Users\\YOU\\.android\\debug.keystore
# storePassword=android
# keyAlias=androiddebugkey
# keyPassword=android

storeFile=C\:\\Users\\shrek\\.android\\debug.keystore
storePassword=android
keyAlias=androiddebugkey
keyPassword=android
