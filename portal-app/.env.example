# ── База ──────────────────────────────────────────────
# Та же база, что у WMS/YMS (wms_edge), или отдельная. Портал создаёт только таблицы portal_*.
PORTAL_DATABASE_URL=postgres://user:password@127.0.0.1:5432/wms_edge?sslmode=disable

# ── Сайт ──────────────────────────────────────────────
PORTAL_PUBLIC_URL=https://scadasystem.io
# Не короче 32 символов. Подписывает сессию, токены формы и хеши IP.
PORTAL_AUTH_SECRET=
PORTAL_CONTACT_EMAIL=
PORTAL_CONTACT_PHONE=
PORTAL_LEGAL_ENTITY=
PORTAL_LEGAL_DETAILS=

# ── Уведомления ───────────────────────────────────────
# Кому писать о новых заявках (через запятую).
PORTAL_ADMIN_NOTIFY_EMAILS=
# Тот же помощник, что у WMS (SMTP настраивается на сервере).
PORTAL_SEND_MAIL_BIN=/usr/local/bin/wms-send-mail.py
PORTAL_MAIL_FROM_NAME=SCADA SYSTEM

# ── SCADA ID: вход (клиент OIDC портала) ──────────────
SCADA_ID_ISSUER=https://id.scada25.ru/realms/scada-system-id
SCADA_ID_API=https://id.scada25.ru
PORTAL_SCADA_ID_CLIENT_ID=scada-portal
PORTAL_SCADA_ID_CLIENT_SECRET=
# Приложение, для которого запрашиваются права в /api/v1/permissions/resolve;
# роль admin/god в нём или is_god/is_super_admin дают доступ к разделу заявок.
PORTAL_SCADA_ID_APPLICATION=scada-portal

# ── SCADA ID: выдача доступа (сервисная учётная запись) ─
# Клиент с client credentials и ролями realm-management: view-users, manage-users, query-groups
# (+ manage-organizations, если включены организации).
PORTAL_SCADA_ID_ADMIN_CLIENT_ID=
PORTAL_SCADA_ID_ADMIN_CLIENT_SECRET=
# Приложение SCADA ID → группа Keycloak, членство в которой даёт доступ.
# Приложения без группы выдаются вручную (заявка подскажет).
PORTAL_SCADA_ID_APP_GROUPS={"scada-wms":"/apps/scada-wms/operator"}
# 1 — организации Keycloak (members API); иначе атрибут пользователя scada_organization.
PORTAL_SCADA_ID_ORGANIZATIONS=0
PORTAL_SCADA_ID_INVITE_ACTIONS=UPDATE_PROFILE,UPDATE_PASSWORD
PORTAL_SCADA_ID_INVITE_LIFESPAN_SEC=259200

# ── Антиспам ──────────────────────────────────────────
PORTAL_FORM_MIN_FILL_MS=4000
PORTAL_RATE_PER_IP_HOUR=5
PORTAL_RATE_PER_EMAIL_DAY=3

# ── Каталог (необязательно) ───────────────────────────
# Статус: live | pilot | on_request | development
# PORTAL_PRODUCT_STATUS_EMS=pilot
# Адрес запуска продукта; none — скрыть кнопку «Открыть»
# PORTAL_APP_URL_XRAY=https://xray.example
# Ключ приложения в SCADA ID (application_slug)
# PORTAL_SCADA_ID_APP_YMS=scada-yms
