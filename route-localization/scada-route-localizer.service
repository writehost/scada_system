[Unit]
Description=SCADA System Route — позиционирование погрузчика (AprilTag)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=route
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/scada-route-localizer/venv/bin/route-localization run --config /etc/scada-route/localizer.json
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
