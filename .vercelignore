scripts/build-tsd-android.mjs
scripts/cap-sync-*.mjs
scripts/android-build-standalone.mjs
scripts/e2e-wms-pages.mjs
scripts/backfill-sku.mjs

# Parent-repo staging used by prebuild-fix (not in interface tree on Vercel)
.wms-update-staging/

